# ---------------------------------------------------------------------------
# Mate by Mathias — variables d'environnement
# Copier ce fichier en .env (développement) ou les définir chez l'hébergeur.
# Aucun de ces secrets ne doit être committé ni exposé côté navigateur :
# seules les variables préfixées NEXT_PUBLIC_ sont envoyées au client.
# ---------------------------------------------------------------------------

# Base de données PostgreSQL.
#
# En production sur Netlify, ces deux lignes peuvent rester vides : si la
# base a été créée depuis Project configuration → Database, Netlify pose
# lui-même NETLIFY_DATABASE_URL et NETLIFY_DATABASE_URL_UNPOOLED, que le
# site sait lire. Rien à recopier, donc rien à se tromper en recopiant.
#
# Renseignées, ces variables l'emportent : c'est ce qu'on veut en
# développement, ou avec un hébergeur de base choisi soi-même.
DATABASE_URL="postgresql://user:password@localhost:5432/mate_by_mathias?schema=public"
# URL directe (sans mutualiseur), réservée aux migrations.
DIRECT_URL="postgresql://user:password@localhost:5432/mate_by_mathias?schema=public"

# Auth.js — générer avec: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Clé de chiffrement des secrets 2FA au repos (32 octets en base64)
# openssl rand -base64 32
ENCRYPTION_KEY=""

# Sel utilisé pour hacher les IP (preuves de consentement, journal d'audit)
# openssl rand -hex 32
IP_HASH_SALT=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# PayPal
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENVIRONMENT="sandbox"
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""

# Emails transactionnels (Resend)
RESEND_API_KEY=""
EMAIL_FROM="Mate by Mathias <contact@matebymathias.fr>"
EMAIL_CONTACT="contact@matebymathias.fr"

# Stockage des médias (Cloudflare R2 ou compatible S3)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
NEXT_PUBLIC_MEDIA_BASE_URL=""

# Divers
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
